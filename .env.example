# Copy to .env and fill in real values. Never commit .env - it's gitignored.

# Backend API (leave unset in dev to use the Vite proxy to localhost:8000;
# set explicitly to point at a remote backend, e.g. for local testing against prod)
# VITE_BACKEND_URL=http://localhost:8000

# Firebase (push notifications) - get these from
# Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# HeyLua / LuaPop dashboard agent (defaults to /api/agent/config/ agent_id when unset)
# VITE_LUA_AGENT_ID=baseAgent_agent_1762796132079_ob3ln5fkl

# Optional feature flags
# VITE_ENABLE_CHECKLIST_TELEMETRY=false
