# Mizan_FE — Git ignore (production push hygiene)

# Dependencies & builds
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
.parcel-cache/
*.local

# Env (only .env.example is allowed)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage artifacts (source tests may still be committed)
coverage/
.nyc_output/
*.tsbuildinfo
playwright-report/
test-results/
vitest.config.ts.timestamp-*

# Runtime
server.pid
*.pid

# IDE / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/
.claude/
*.bak
*.orig
*.tmp

# Optional local storybook / story dumps
storybook-static/
